{
    "name": "s7-exit-transition-several-exit-nodes",
    "description": "One transition may handle several exit nodes (# X1> X2>): it is taken when any of them is reached.",
    "text": [
        "statemachine M {",
        "    interface:",
        "        in event a",
        "        in event b",
        "        in event c",
        "        operation log(msg : string) : void",
        "    [*] -> P",
        "    state P {",
        "        exit / log(\"exit P\")",
        "        [*] -> A",
        "        exit X1",
        "        exit X2",
        "        exit X3",
        "        state A",
        "        A -> X1 : a",
        "        A -> X2 : b",
        "        A -> X3 : c",
        "    }",
        "    state Done",
        "    state Other",
        "    P -> Done : / log(\"handled\") # X1> X2>",
        "    P -> Other : / log(\"other\") # X3>",
        "    Done -> P : a",
        "    Other -> P : a",
        "}"
    ],
    "steps": [
        {"enter": true},
        {"raise": "b"},
        {"runCycle": true},
        {"expect": {"configuration": ["Done"], "calls": ["log(\"exit P\")", "log(\"handled\")"]}},
        {"raise": "a"},
        {"runCycle": true},
        {"expect": {"configuration": ["P.A"]}},
        {"raise": "a"},
        {"runCycle": true},
        {"expect": {"configuration": ["Done"], "calls": ["log(\"exit P\")", "log(\"handled\")"]}},
        {"raise": "a"},
        {"runCycle": true},
        {"raise": "c"},
        {"runCycle": true},
        {"expect": {"configuration": ["Other"], "calls": ["log(\"exit P\")", "log(\"other\")"]}}
    ]
}
