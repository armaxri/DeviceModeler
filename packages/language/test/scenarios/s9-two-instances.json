{
    "name": "s9-two-instances",
    "description": "Two instances of the same state machine have their own configuration and variables.",
    "text": [
        "statemachine Plant {",
        "    import \"motor.hsm\"",
        "    interface:",
        "        in event startLeft",
        "        in event startRight",
        "    internal:",
        "        var left : Motor",
        "        var right : Motor",
        "    startLeft / raise left.start",
        "    startRight / raise right.start",
        "    [*] -> Running",
        "    state Running {",
        "        region Left {",
        "            [*] -> L",
        "            state L : left",
        "        }",
        "        region Right {",
        "            [*] -> R",
        "            state R : right",
        "        }",
        "    }",
        "}"
    ],
    "files": {
        "motor.hsm": [
            "statemachine Motor {",
            "    interface:",
            "        in event start",
            "        in event stop",
            "        out event stopped",
            "        var speed : integer = 0",
            "        operation log(msg : string) : void",
            "    entry / log(\"motor entry\")",
            "    exit / log(\"motor exit\")",
            "    [*] -> Off",
            "    state Off",
            "    state On",
            "    Off -> On : start / speed = 1",
            "    On -> Off : stop / speed = 0; raise stopped",
            "}"
        ]
    },
    "steps": [
        {"enter": true},
        {"expect": {"configuration": ["left.Off", "right.Off"]}},
        {"raise": "startLeft"},
        {"runCycle": true},
        {"expect": {"configuration": ["left.On", "right.Off"], "variables": {"left.speed": 1, "right.speed": 0}}},
        {"raise": "startRight"},
        {"runCycle": true},
        {"expect": {"configuration": ["left.On", "right.On"], "variables": {"left.speed": 1, "right.speed": 1}}}
    ]
}
