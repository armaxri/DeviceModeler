{
    "name": "s7-entry-point-same-name-in-regions",
    "description": "Entry points with the same name in several orthogonal regions: # >E enters every region with an entry point E through it, the others by default.",
    "text": [
        "statemachine M {",
        "    interface:",
        "        in event go",
        "        in event fail",
        "        in event reset",
        "        operation log(msg : string) : void",
        "    [*] -> Idle",
        "    state Idle",
        "    state P {",
        "        entry / log(\"enter P\")",
        "        region R1 {",
        "            [*] -> A1",
        "            entry failure",
        "            state A1",
        "            state F1 {",
        "                entry / log(\"F1\")",
        "            }",
        "            failure -> F1 : / log(\"via R1\")",
        "        }",
        "        region R2 {",
        "            [*] -> A2",
        "            state A2",
        "        }",
        "        region R3 {",
        "            [*] -> A3",
        "            entry failure",
        "            state A3",
        "            state F3 {",
        "                entry / log(\"F3\")",
        "            }",
        "            failure -> F3 : / log(\"via R3\")",
        "        }",
        "    }",
        "    Idle -> P : go",
        "    Idle -> P : fail # >failure",
        "    P -> Idle : reset",
        "}"
    ],
    "steps": [
        {"enter": true},
        {"raise": "go"},
        {"runCycle": true},
        {"expect": {"configuration": ["P.A1", "P.A2", "P.A3"], "calls": ["log(\"enter P\")"]}},
        {"raise": "reset"},
        {"runCycle": true},
        {"raise": "fail"},
        {"runCycle": true},
        {"expect": {"configuration": ["P.F1", "P.A2", "P.F3"], "calls": ["log(\"enter P\")", "log(\"via R1\")", "log(\"F1\")", "log(\"via R3\")", "log(\"F3\")"]}}
    ]
}
