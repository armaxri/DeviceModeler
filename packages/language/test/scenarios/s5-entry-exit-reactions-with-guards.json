{
    "name": "s5-entry-exit-reactions-with-guards",
    "description": "Entry and exit reactions are executed when the state is entered / exited, guards are evaluated at that time.",
    "text": [
        "statemachine M {",
        "    interface:",
        "        in event e",
        "        var flag : boolean",
        "        var entries : integer",
        "        var exits : integer",
        "    [*] -> A",
        "    state A {",
        "        entry [flag] / entries += 1",
        "        exit [flag] / exits += 1",
        "        entry / flag = !flag",
        "    }",
        "    A -> A : e",
        "}"
    ],
    "steps": [
        {"enter": true},
        {"expect": {"variables": {"entries": 0, "exits": 0, "flag": true}}},
        {"raise": "e"},
        {"runCycle": true},
        {"expect": {"variables": {"entries": 1, "exits": 1, "flag": false}}},
        {"raise": "e"},
        {"runCycle": true},
        {"expect": {"variables": {"entries": 1, "exits": 1, "flag": true}}},
        {"raise": "e"},
        {"runCycle": true},
        {"expect": {"variables": {"entries": 2, "exits": 2}}}
    ]
}
