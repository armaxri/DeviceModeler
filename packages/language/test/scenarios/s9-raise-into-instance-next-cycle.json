{
    "name": "s9-raise-into-instance-next-cycle",
    "description": "Cycle based: an in event raised on an instance becomes present in the next processing of the instance. Raised by the transition entering its state, the instance processes it in the next cycle.",
    "text": [
        "statemachine Door {",
        "    import \"motor.hsm\"",
        "    interface:",
        "        in event open",
        "        in event close",
        "    internal:",
        "        var motor : Motor",
        "    [*] -> Closed",
        "    state Closed",
        "    state Moving : motor",
        "    Closed -> Moving : open / raise motor.start",
        "    Moving -> Closed : close",
        "}"
    ],
    "files": {
        "motor.hsm": [
            "statemachine Motor {",
            "    interface:",
            "        in event start",
            "        in event stop",
            "        out event stopped",
            "        var speed : integer = 0",
            "        operation log(msg : string) : void",
            "    entry / log(\"motor entry\")",
            "    exit / log(\"motor exit\")",
            "    [*] -> Off",
            "    state Off",
            "    state On",
            "    Off -> On : start / speed = 1",
            "    On -> Off : stop / speed = 0; raise stopped",
            "}"
        ]
    },
    "steps": [
        {"enter": true},
        {"raise": "open"},
        {"runCycle": true},
        {"expect": {"configuration": ["motor.Off"], "variables": {"motor.speed": 0}}},
        {"runCycle": true},
        {"expect": {"configuration": ["motor.On"], "variables": {"motor.speed": 1}}}
    ]
}
