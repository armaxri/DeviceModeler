{
    "name": "s7-join",
    "description": "Join: fires only when all incoming transitions are enabled in the same step; effects in priority order.",
    "text": [
        "statemachine M {",
        "    interface:",
        "        in event a",
        "        in event b",
        "        in event done",
        "        var log : string",
        "    [*] -> P",
        "    state P {",
        "        region R1 {",
        "            [*] -> A1",
        "            state A1",
        "            state A2",
        "            A1 -> A2 : a",
        "        }",
        "        region R2 {",
        "            [*] -> B1",
        "            state B1",
        "            state B2",
        "            B1 -> B2 : b",
        "        }",
        "    }",
        "    state Q",
        "    sync J",
        "    P.A2 -> J : done / log = log + \"1\"",
        "    P.B2 -> J : done / log = log + \"2\"",
        "    J -> Q : / log = log + \"3\"",
        "}"
    ],
    "steps": [
        {"enter": true},
        {"raise": "a"},
        {"runCycle": true},
        {"raise": "done"},
        {"runCycle": true},
        {"expect": {"configuration": ["P.A2", "P.B1"]}},
        {"raise": "b"},
        {"runCycle": true},
        {"expect": {"configuration": ["P.A2", "P.B2"]}},
        {"raise": "done"},
        {"runCycle": true},
        {"expect": {"configuration": ["Q"], "variables": {"log": "123"}}}
    ]
}
