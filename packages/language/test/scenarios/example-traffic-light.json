{
    "name": "example-traffic-light",
    "description": "Traffic light: cycle period 100 ms, after / every time events, guards on time triggers, named interface.",
    "model": "../../../../examples/traffic-light.hsm",
    "steps": [
        {"enter": true},
        {"expect": {"configuration": ["Off"], "calls": ["switchOn(0)"], "variables": {"lights": 0, "Pedestrian.waiting": false}}},
        {"raise": "powerOn"},
        {"runCycle": true},
        {"expect": {"configuration": ["Operating.Red"], "calls": ["switchOn(1)"], "outEvents": ["lightsChanged(1)"]}},
        {"runFor": 19900},
        {"expect": {"configuration": ["Operating.Red"], "calls": []}},
        {"runFor": 100},
        {"expect": {"configuration": ["Operating.RedYellow"], "calls": ["switchOn(3)"], "variables": {"lights": 3}}},
        {"runFor": 2000},
        {"expect": {"configuration": ["Operating.Green"], "calls": ["switchOn(4)"]}},
        {"raise": "Pedestrian.request"},
        {"runFor": 100},
        {"expect": {"variables": {"Pedestrian.waiting": true}}},
        {"runFor": 29900},
        {"expect": {"configuration": ["Operating.Yellow"], "calls": ["switchOn(2)"]}},
        {"runFor": 3000},
        {"expect": {"configuration": ["Operating.Red"], "calls": ["switchOn(1)"], "outEvents": ["lightsChanged(1)"], "variables": {"Pedestrian.waiting": false}}},
        {"raise": "failure"},
        {"runCycle": true},
        {"expect": {"configuration": ["Blinking"], "calls": []}},
        {"runFor": 500},
        {"expect": {"calls": ["switchOn(3)"], "variables": {"lights": 3}}},
        {"runFor": 500},
        {"expect": {"calls": ["switchOn(1)"], "variables": {"lights": 1}}},
        {"raise": "powerOff"},
        {"runCycle": true},
        {"expect": {"configuration": ["Off"], "calls": ["switchOn(0)"], "variables": {"lights": 0}}}
    ]
}
