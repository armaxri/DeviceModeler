{
    "name": "example-cd-player",
    "description": "CD player: choice with operation call, local reaction with guard, shallow history, final state.",
    "model": "../../../../examples/cd-player.hsm",
    "operations": {"discInserted": [true]},
    "steps": [
        {"enter": true},
        {"expect": {"configuration": ["Closed.Stopped"], "variables": {"track": 1, "tracks": 0}, "calls": []}},
        {"set": {"tracks": 3}},
        {"raise": "play"},
        {"runCycle": true},
        {"expect": {"configuration": ["Closed.Active.Playing"], "calls": ["discInserted()", "startMotor()"]}},
        {"raise": "trackEnd"},
        {"runCycle": true},
        {"raise": "trackEnd"},
        {"runCycle": true},
        {"raise": "trackEnd"},
        {"runCycle": true},
        {"expect": {"variables": {"track": 3}, "active": ["Playing"]}},
        {"raise": "pause"},
        {"runCycle": true},
        {"expect": {"configuration": ["Closed.Active.Paused"], "calls": ["stopMotor()"]}},
        {"raise": "eject"},
        {"runCycle": true},
        {"expect": {"configuration": ["Open"], "inactive": ["Closed"]}},
        {"raise": "eject"},
        {"runCycle": true},
        {"expect": {"configuration": ["Closed.Active.Playing"], "calls": ["startMotor()"], "variables": {"track": 3}}},
        {"raise": "stop"},
        {"runCycle": true},
        {"expect": {"configuration": ["Closed.Stopped"], "calls": ["stopMotor()"], "variables": {"track": 1}}},
        {"raise": "powerOff"},
        {"runCycle": true},
        {"expect": {"final": true, "configuration": []}}
    ]
}
