{
    "name": "s7-fork",
    "description": "Fork: the effects of all outgoing transitions are executed, then all targets are entered together, other regions by default.",
    "text": [
        "statemachine M {",
        "    interface:",
        "        in event go",
        "        operation log(msg : string) : void",
        "    [*] -> Idle",
        "    state Idle",
        "    state P {",
        "        entry / log(\"enter P\")",
        "        region R1 {",
        "            [*] -> A1",
        "            state A1",
        "            state A2 {",
        "                entry / log(\"A2\")",
        "            }",
        "        }",
        "        region R2 {",
        "            [*] -> B1",
        "            state B1",
        "            state B2 {",
        "                entry / log(\"B2\")",
        "            }",
        "        }",
        "        region R3 {",
        "            [*] -> C1",
        "            state C1 {",
        "                entry / log(\"C1\")",
        "            }",
        "        }",
        "    }",
        "    sync F",
        "    Idle -> F : go / log(\"in\")",
        "    F -> P.A2 : / log(\"out 1\")",
        "    F -> P.B2 : / log(\"out 2\")",
        "}"
    ],
    "steps": [
        {"enter": true},
        {"raise": "go"},
        {"runCycle": true},
        {"expect": {"configuration": ["P.A2", "P.B2", "P.C1"], "calls": ["log(\"in\")", "log(\"out 1\")", "log(\"out 2\")", "log(\"enter P\")", "log(\"A2\")", "log(\"B2\")", "log(\"C1\")"]}}
    ]
}
