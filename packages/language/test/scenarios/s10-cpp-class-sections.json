{
    "name": "s10-cpp-class-sections",
    "description": "Members of the C++ class sections (public:, protected:, private:): variables are initialized once when the object is constructed and are not reset by enter(), constants have their initial value, member functions are called like operations (the harness defines them; scripted results), members with types the model does not know (a pointer) are declared but not used.",
    "text": [
        "statemachine M {",
        "    import \"app.h\"",
        "    interface:",
        "        in event go",
        "        in event stop",
        "        var count : integer",
        "    public:",
        "        /** Sets the configuration. */",
        "        operation setConfig(config : const app::Config&) : void",
        "        operation limit() : unsigned int",
        "    protected:",
        "        /**",
        "         * @brief Setup function.",
        "         */",
        "        operation setup()",
        "        var driver : app::Driver*",
        "    private:",
        "        var errorCnt : unsigned int = 1",
        "        const maxErrors : unsigned int = app::kMaxErrors",
        "        var config : app::Config",
        "        var mode : app::Mode = app::Mode::Slow",
        "    [*] -> Idle",
        "    state Idle {",
        "        entry / setup()",
        "    }",
        "    state Running",
        "    Idle -> Running : go [errorCnt < limit() && errorCnt < maxErrors] / errorCnt++; config.retries = errorCnt; setConfig(config); count += 1",
        "    Running -> Idle : stop",
        "}"
    ],
    "files": {
        "app.h": [
            "#ifndef APP_H",
            "#define APP_H",
            "",
            "namespace app {",
            "",
            "enum class Mode { Off, Slow, Fast };",
            "",
            "struct Config {",
            "    int retries = 0;",
            "    Mode mode = Mode::Off;",
            "};",
            "",
            "class Driver;",
            "",
            "constexpr unsigned int kMaxErrors = 5;",
            "",
            "}  // namespace app",
            "",
            "#endif"
        ]
    },
    "operations": {
        "limit": [3, 0]
    },
    "steps": [
        {"enter": true},
        {"expect": {"active": ["Idle"], "variables": {"errorCnt": 1, "maxErrors": 5, "mode": "app::Mode::Slow", "count": 0}, "calls": ["setup()"]}},
        {"set": {"errorCnt": 2}},
        {"raise": "go"},
        {"runCycle": true},
        {"expect": {"active": ["Running"], "variables": {"errorCnt": 3, "config": {"retries": 3}, "count": 1}, "calls": ["limit()", "setConfig({retries: 3, mode: app::Mode::Off})"]}},
        {"raise": "stop"},
        {"runCycle": true},
        {"raise": "go"},
        {"runCycle": true},
        {"expect": {"active": ["Idle"], "variables": {"errorCnt": 3}, "calls": ["setup()", "limit()"]}},
        {"exit": true},
        {"enter": true},
        {"expect": {"active": ["Idle"], "variables": {"errorCnt": 3, "config": {"retries": 3}, "count": 0}, "calls": ["setup()"]}}
    ]
}
