{
    "projectName": "Hsm",
    "languages": [{
        "id": "hsm",
        "grammar": "src/hsm.langium",
        "fileExtensions": [".hsm"],
        "textMate": {
            "out": "syntaxes/hsm.tmLanguage.json"
        },
        "monarch": {
            "out": "src/syntaxes/hsm.monarch.ts"
        }
    }, {
        "id": "hsmtest",
        "grammar": "src/hsm-test.langium",
        "fileExtensions": [".hsmtest"],
        "textMate": {
            "out": "syntaxes/hsmtest.tmLanguage.json"
        }
    }],
    "out": "src/generated"
}
