{
    "projectName": "Devm",
    "languages": [
        {
            "id": "devm",
            "grammar": "src/devm.langium",
            "fileExtensions": [
                ".devm"
            ],
            "textMate": {
                "out": "syntaxes/devm.tmLanguage.json"
            },
            "monarch": {
                "out": "src/syntaxes/devm.monarch.ts"
            }
        },
        {
            "id": "devmtest",
            "grammar": "src/devm-test.langium",
            "fileExtensions": [
                ".devmtest"
            ],
            "textMate": {
                "out": "syntaxes/devmtest.tmLanguage.json"
            }
        }
    ],
    "out": "src/generated"
}
