{
  "$comment": "Documentation comments (/** … */) of .hsm and .hsmtest files with highlighted Doxygen / JSDoc commands (injected into the grammars generated by langium; scope names like the C++ grammar of VS Code).",
  "name": "HSM documentation comments",
  "scopeName": "documentation.injection.hsm",
  "injectionSelector": "L:source.hsm -comment -string, L:source.hsmtest -comment -string",
  "patterns": [
    {
      "include": "#doc-comment"
    }
  ],
  "repository": {
    "doc-comment": {
      "name": "comment.block.documentation.hsm",
      "begin": "/\\*\\*(?![*/])",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.documentation.hsm"
        }
      },
      "end": "\\*/",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.documentation.hsm"
        }
      },
      "patterns": [
        {
          "include": "#code"
        },
        {
          "include": "#parameter"
        },
        {
          "include": "#inline"
        },
        {
          "include": "#link"
        },
        {
          "include": "#command"
        }
      ]
    },
    "code": {
      "begin": "\\B([@\\\\]code)(\\{[^}]*\\})?",
      "beginCaptures": {
        "1": {
          "name": "storage.type.class.doxygen.hsm"
        },
        "2": {
          "name": "entity.name.type.language.doxygen.hsm"
        }
      },
      "end": "\\B([@\\\\]endcode)\\b|(?=\\*/)",
      "endCaptures": {
        "1": {
          "name": "storage.type.class.doxygen.hsm"
        }
      },
      "contentName": "markup.raw.block.doxygen.hsm"
    },
    "parameter": {
      "match": "\\B([@\\\\](?:param|tparam|retval|throws?|exception))(\\[[^\\]]*\\])?(?:\\s+(\\{[^}]*\\}))?\\s+([^\\s*]+)",
      "captures": {
        "1": {
          "name": "storage.type.class.doxygen.hsm"
        },
        "2": {
          "name": "keyword.other.parameter.direction.doxygen.hsm"
        },
        "3": {
          "name": "entity.name.type.doxygen.hsm"
        },
        "4": {
          "name": "variable.parameter.doxygen.hsm"
        }
      }
    },
    "inline": {
      "patterns": [
        {
          "match": "\\B([@\\\\][cp])\\s+([^\\s*]+)",
          "captures": {
            "1": {
              "name": "storage.type.class.doxygen.hsm"
            },
            "2": {
              "name": "markup.inline.raw.string.doxygen.hsm"
            }
          }
        },
        {
          "match": "\\B([@\\\\](?:a|e|em))\\s+([^\\s*]+)",
          "captures": {
            "1": {
              "name": "storage.type.class.doxygen.hsm"
            },
            "2": {
              "name": "markup.italic.doxygen.hsm"
            }
          }
        },
        {
          "match": "\\B([@\\\\]b)\\s+([^\\s*]+)",
          "captures": {
            "1": {
              "name": "storage.type.class.doxygen.hsm"
            },
            "2": {
              "name": "markup.bold.doxygen.hsm"
            }
          }
        }
      ]
    },
    "link": {
      "match": "(\\{)(@link(?:code|plain)?)\\s+([^\\s}|]+)[^}]*(\\})",
      "captures": {
        "1": {
          "name": "punctuation.definition.bracket.curly.begin.jsdoc"
        },
        "2": {
          "name": "storage.type.class.doxygen.hsm"
        },
        "3": {
          "name": "variable.other.link.underline.jsdoc"
        },
        "4": {
          "name": "punctuation.definition.bracket.curly.end.jsdoc"
        }
      }
    },
    "command": {
      "match": "\\B[@\\\\](?:[a-zA-Z]+\\b|[{}])",
      "name": "storage.type.class.doxygen.hsm"
    }
  }
}
