{
  "name": "devmtest",
  "scopeName": "source.devmtest",
  "fileTypes": [
    ".devmtest"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.devmtest",
      "match": "\\b(statemachine|component|operation|subsystem|testclass|behavior|delegate|readonly|connect|message|package|proceed|returns|valueof|active|assert|called|struct|system|thread|async|const|enter|false|inout|raise|times|while|else|exit|mock|null|true|with|for|var|as|if)\\b"
    },
    {
      "name": "string.quoted.double.devmtest",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    },
    {
      "name": "string.quoted.single.devmtest",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.devmtest",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.devmtest"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.devmtest"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.devmtest"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.devmtest"
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.devmtest",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
