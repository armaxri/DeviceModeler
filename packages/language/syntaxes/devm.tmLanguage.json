{
  "name": "devm",
  "scopeName": "source.devm",
  "fileTypes": [
    ".devm"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.devm",
      "match": "\\b(statemachine|deephistory|component|interface|namespace|operation|protected|subsystem|behavior|delegate|internal|junction|readonly|unsigned|connect|default|history|oncycle|package|private|valueof|active|always|choice|double|import|public|region|signed|static|struct|system|thread|after|alias|async|const|entry|event|every|false|float|inout|raise|short|state|bool|char|else|exit|long|null|sync|true|void|int|out|var|as|in)\\b"
    },
    {
      "name": "string.quoted.double.devm",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    },
    {
      "name": "string.quoted.single.devm",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.devm",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.devm"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.devm"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.devm"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.devm"
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.devm",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
