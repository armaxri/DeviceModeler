{
  "name": "hsm",
  "scopeName": "source.hsm",
  "fileTypes": [
    ".hsm"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.hsm",
      "match": "\\b(statemachine|deephistory|interface|namespace|operation|internal|junction|readonly|default|history|oncycle|valueof|active|always|choice|region|after|alias|const|entry|event|every|false|raise|state|else|exit|null|sync|true|out|var|as|in)\\b"
    },
    {
      "name": "string.quoted.double.hsm",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    },
    {
      "name": "string.quoted.single.hsm",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.hsm",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.hsm"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.hsm"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.hsm"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.hsm"
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.hsm",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
