{
  "name": "hsm-vscode",
  "displayName": "Device Modeler (manual layout)",
  "description": "Device Modeler: the structure of a product (components, ports, threads, instances, connections) as SysML internal block diagrams and its hierarchical state machines with their unit tests, in .devm and .devmtest files: language server, PlantUML-style diagram editors, C++ code generation, test runner and itemis CREATE import – experimental build with hand-arranged diagrams (layout annotations in the model)",
  "version": "0.1.0-manual-layout",
  "private": true,
  "publisher": "hsm-modeler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arnemrichter/HSM"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Testing"
  ],
  "keywords": [
    "statechart",
    "state machine",
    "hsm",
    "itemis CREATE",
    "YAKINDU",
    "PlantUML",
    "SysML",
    "internal block diagram",
    "device modeling",
    "device modeler"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/*.devm",
    "workspaceContains:**/*.devmtest",
    "onLanguage:devm",
    "onLanguage:devmtest",
    "onWebviewPanel:hsm.diagram",
    "onCommand:hsm.importSct"
  ],
  "contributes": {
    "languages": [
      {
        "id": "devm",
        "aliases": [
          "Device Modeler",
          "devm"
        ],
        "extensions": [
          ".devm"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "devmtest",
        "aliases": [
          "Device Modeler Test",
          "devmtest"
        ],
        "extensions": [
          ".devmtest"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "devm",
        "scopeName": "source.devm",
        "path": "./syntaxes/devm.tmLanguage.json"
      },
      {
        "language": "devmtest",
        "scopeName": "source.devmtest",
        "path": "./syntaxes/devmtest.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "hsm.openDiagram",
        "title": "Open Diagram",
        "category": "Device Modeler",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "hsm.generateCpp",
        "title": "Generate C++",
        "category": "Device Modeler"
      },
      {
        "command": "hsm.runTests",
        "title": "Run Tests",
        "category": "Device Modeler",
        "icon": "$(run-all)"
      },
      {
        "command": "hsm.importSct",
        "title": "Import itemis CREATE Model (.sct)",
        "category": "Device Modeler"
      },
      {
        "command": "hsm.exportDiagram",
        "title": "Export Diagram…",
        "category": "Device Modeler"
      },
      {
        "command": "hsm.autoArrange",
        "title": "Auto-arrange Diagram",
        "category": "Device Modeler",
        "icon": "$(layout)"
      },
      {
        "command": "hsm.resetLayout",
        "title": "Use Automatic Diagram Layout",
        "category": "Device Modeler",
        "icon": "$(discard)"
      },
      {
        "command": "hsm.convertLayoutFile",
        "title": "Convert Layout File to Annotations",
        "category": "Device Modeler"
      },
      {
        "command": "hsm.navigateBack",
        "title": "Diagram: Go Back",
        "category": "Device Modeler",
        "icon": "$(arrow-left)"
      },
      {
        "command": "hsm.navigateForward",
        "title": "Diagram: Go Forward",
        "category": "Device Modeler",
        "icon": "$(arrow-right)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hsm.openDiagram",
          "when": "editorLangId == devm",
          "group": "navigation"
        },
        {
          "command": "hsm.runTests",
          "when": "editorLangId == devmtest",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "hsm.openDiagram",
          "when": "editorLangId == devm",
          "group": "hsm@1"
        },
        {
          "command": "hsm.generateCpp",
          "when": "editorLangId == devm && !hsm.structureEditorActive",
          "group": "hsm@2"
        },
        {
          "command": "hsm.exportDiagram",
          "when": "editorLangId == devm",
          "group": "hsm@3"
        }
      ],
      "explorer/context": [
        {
          "command": "hsm.openDiagram",
          "when": "resourceExtname == .devm",
          "group": "hsm@1"
        },
        {
          "command": "hsm.generateCpp",
          "when": "resourceExtname == .devm",
          "group": "hsm@2"
        },
        {
          "command": "hsm.exportDiagram",
          "when": "resourceExtname == .devm",
          "group": "hsm@3"
        },
        {
          "command": "hsm.runTests",
          "when": "resourceExtname == .devmtest",
          "group": "hsm@1"
        },
        {
          "command": "hsm.importSct",
          "when": "resourceExtname == .sct",
          "group": "hsm@1"
        }
      ],
      "commandPalette": [
        {
          "command": "hsm.openDiagram",
          "when": "editorLangId == devm || activeWebviewPanelId == hsm.diagram"
        },
        {
          "command": "hsm.generateCpp",
          "when": "editorLangId == devm && !hsm.structureEditorActive || activeWebviewPanelId == hsm.diagram && !hsm.structureDiagramActive"
        },
        {
          "command": "hsm.exportDiagram",
          "when": "editorLangId == devm || activeWebviewPanelId == hsm.diagram"
        },
        {
          "command": "hsm.autoArrange",
          "when": "editorLangId == devm || activeWebviewPanelId == hsm.diagram"
        },
        {
          "command": "hsm.resetLayout",
          "when": "editorLangId == devm || activeWebviewPanelId == hsm.diagram"
        },
        {
          "command": "hsm.convertLayoutFile",
          "when": "editorLangId == devm && !hsm.structureEditorActive || activeWebviewPanelId == hsm.diagram && !hsm.structureDiagramActive"
        },
        {
          "command": "hsm.navigateBack",
          "when": "hsm.diagramCanGoBack"
        },
        {
          "command": "hsm.navigateForward",
          "when": "hsm.diagramCanGoForward"
        }
      ],
      "webview/title": [
        {
          "command": "hsm.autoArrange",
          "when": "activeWebviewPanelId == hsm.diagram",
          "group": "hsmLayout@1"
        },
        {
          "command": "hsm.resetLayout",
          "when": "activeWebviewPanelId == hsm.diagram",
          "group": "hsmLayout@2"
        }
      ]
    },
    "configuration": {
      "title": "Device Modeler",
      "properties": {
        "hsm.diagram.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "Open the diagram beside the editor whenever a .devm file (state machine or structure file) is opened in an editor."
        },
        "hsm.diagram.theme": {
          "type": "string",
          "enum": [
            "auto",
            "classic",
            "modern",
            "dark"
          ],
          "enumDescriptions": [
            "Follow the VS Code color theme: light themes use `#hsm.diagram.lightTheme#`, dark and high contrast themes the dark diagram theme",
            "PlantUML classic (yellow / red)",
            "PlantUML modern (gray)",
            "Dark"
          ],
          "default": "auto",
          "markdownDescription": "Theme of the diagram. `auto` follows the VS Code color theme."
        },
        "hsm.diagram.lightTheme": {
          "type": "string",
          "enum": [
            "classic",
            "modern",
            "dark"
          ],
          "default": "classic",
          "markdownDescription": "Diagram theme used with light VS Code color themes when `#hsm.diagram.theme#` is `auto`."
        },
        "hsm.diagram.direction": {
          "type": "string",
          "enum": [
            "DOWN",
            "RIGHT"
          ],
          "enumDescriptions": [
            "Top to bottom",
            "Left to right"
          ],
          "default": "DOWN",
          "description": "Layout direction of the diagram."
        },
        "hsm.diagram.edgeRouting": {
          "type": "string",
          "enum": [
            "SPLINES",
            "ORTHOGONAL",
            "POLYLINE"
          ],
          "default": "SPLINES",
          "description": "Routing of the transitions in the diagram."
        },
        "hsm.diagram.priorities": {
          "type": "boolean",
          "default": true,
          "description": "Show the priorities of transitions leaving a vertex with several outgoing transitions."
        },
        "hsm.diagram.showProperties": {
          "type": "boolean",
          "default": true,
          "description": "Show the properties panel next to the diagram."
        },
        "hsm.cpp.outputDirectory": {
          "type": "string",
          "default": "",
          "markdownDescription": "Output directory of **Device Modeler: Generate C++**, relative to the model file (absolute paths and `${workspaceFolder}` are supported). Empty: the directory of the model. A generator configuration (`devm.gen.json` or `*.devm.gen.json` in the directory of the model or a parent directory) that lists the model takes precedence over all `hsm.cpp.*` settings."
        },
        "hsm.cpp.namespace": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "markdownDescription": "Namespace of the generated C++ class (e.g. `app::sm`). `null`: the namespace of the model; empty string: the global namespace."
        },
        "hsm.cpp.standard": {
          "type": "string",
          "enum": [
            "17",
            "11"
          ],
          "default": "17",
          "description": "C++ standard of the generated code."
        },
        "hsm.headers.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Include directories for imported C/C++ headers (`import \"motor_types.h\"`), searched after the directory of the model; relative to the workspace folder (`${workspaceFolder}` is supported). They are added to the `includePaths` of the `headers` block of the nearest `devm.gen.json`."
        },
        "hsm.headers.defines": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          },
          "default": {},
          "markdownDescription": "Predefined macros for the analysis of imported C/C++ headers (like `-D`): `\"NAME\": \"value\"` (`\"\"` for a macro without value). They override the `defines` of `devm.gen.json`."
        },
        "hsm.headers.dataModel": {
          "type": "string",
          "enum": [
            "",
            "lp64",
            "llp64",
            "ilp32"
          ],
          "default": "",
          "markdownDescription": "Data model of the target for imported C/C++ headers (widths of `long` and `size_t`): `lp64` (Linux / macOS 64-bit, the default), `llp64` (Windows 64-bit), `ilp32` (32-bit targets like ARM Cortex-M). Empty: the `dataModel` of `devm.gen.json` or LP64."
        },
        "hsm.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Device Modeler language server."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "devm.gen.json",
          "*.devm.gen.json"
        ],
        "url": "./schemas/devm-gen.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "test": "vitest run",
    "package": "node scripts/build.mjs && node scripts/package.mjs"
  },
  "dependencies": {
    "hsm-language": "0.1.0",
    "hsm-web": "0.1.0",
    "langium": "~4.4.0",
    "vscode-languageclient": "~10.1.2",
    "vscode-languageserver": "~10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "~3.9.2",
    "esbuild": "~0.28.2",
    "vite": "~7.3.6",
    "vitest": "~3.2.7",
    "vscode-jsonrpc": "~9.0.3"
  }
}
