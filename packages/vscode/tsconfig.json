{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node", "vscode"],
    "noEmit": true,
    "declaration": false,
    "paths": {
      "hsm-language": ["../language/src/index.ts"],
      "@hsm-web/diagram/manual-layout-support.js": ["../web/src/diagram/manual-layout-support.ts"],
      "@hsm-web/ui/side-panel-state.js": ["../web/src/ui/side-panel-state.ts"],
      "@hsm-web/ui/tooltip-position.js": ["../web/src/ui/tooltip-position.ts"],
      "@hsm-web/ui/drag-geometry.js": ["../web/src/ui/drag-geometry.ts"],
      "@hsm-web/layout-actions.js": ["../web/src/layout-actions.ts"]
    }
  },
  "include": ["src/extension/**/*.ts", "src/server/**/*.ts", "src/common/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
