{
  "name": "devm-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Self-contained hsm command line executable (Node.js single executable application), no Node.js installation needed",
  "type": "module",
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "build:exe": "node scripts/build.mjs && node scripts/sea.mjs",
    "smoke-test": "node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "~0.28.2",
    "postject": "1.0.0-alpha.6"
  }
}
