// Entry points, exit nodes and synchronization (fork / join) in the style of itemis CREATE.
/** Automatic door with obstacle detection and a service mode. */
statemachine Door {
    @EventDriven
    @ChildFirstExecution

    interface:
        in event open
        in event close
        in event obstacle
        in event motorStopped
        in event serviceDone
        /** Raised when the door is blocked by an obstacle. */
        out event alarm
        /** Number of times the door has been closed. */
        var cycles : integer = 0

    [*] -> Closed

    state Closed {
        entry / cycles += 1
    }

    /** The motor moves the door up (entry point `Opening`) or down (`Closing`). */
    state Moving {
        entry Opening
        entry Closing
        exit Blocked

        state Up
        state Down
        Opening -> Up
        Closing -> Down
        Up -> Blocked : obstacle
        Down -> Blocked : obstacle
    }

    state Service {
        region Lock {
            [*] -> Unlocked
            state Unlocked
            state Locked
            Unlocked -> Locked : close
        }
        region Light {
            [*] -> Off
            state Off
            state On
            Off -> On : open
        }
    }

    /** Enters both regions of `Service` at once. */
    sync Fork
    sync Join

    Closed -> Moving : open # >Opening
    Moving.Up -> Closed : motorStopped
    Moving.Down -> Closed : motorStopped
    Moving -> Fork : / raise alarm # Blocked>
    Fork -> Service.Locked
    Fork -> Service.On
    Service.Locked -> Join : serviceDone
    Service.On -> Join : serviceDone
    Join -> Closed
}
