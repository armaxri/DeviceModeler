// A conveyor belt that uses the types and constants of a C++ header (conveyor_types.h): an enum
// class (conveyor::Mode), flags of an unscoped enum (conveyor::Fault), structs with default member
// initializers (conveyor::Package, conveyor::Settings), a type alias (conveyor::Speed) and constants.
statemachine Conveyor "Belt conveyor using the types of a C++ header" {
    namespace example
    import "conveyor_types.h"

    @CycleBased(100)

    interface:
        in event start
        in event stop
        /** A package arrived at the light barrier. */
        in event packageDetected : conveyor::Package
        in event fault : conveyor::Fault
        in event reset
        out event modeChanged : conveyor::Mode
        /** A package that is too heavy is pushed off the belt. */
        out event rejected : conveyor::Package
        var mode : conveyor::Mode
        var settings : conveyor::Settings = conveyor::kDefaultSettings
        var faults : integer
        var count : uint16_t
        var last : conveyor::Package
        /** Sets the speed of the belt drive. */
        operation setSpeed(speed : conveyor::Speed) : void

    [*] -> Idle

    state Idle {
        entry / mode = conveyor::Mode::Stopped; setSpeed(0); raise modeChanged : mode
    }

    state Operating {
        [*] -> Running
        state Running {
            entry / mode = conveyor::Mode::Normal; setSpeed(settings.normalSpeed); raise modeChanged : mode
            packageDetected [!valueof(packageDetected).fragile && valueof(packageDetected).weightGrams <= settings.maxWeightGrams] / last = valueof(packageDetected); count++
        }
        state Careful {
            entry / mode = conveyor::Mode::Slow; setSpeed(settings.slowSpeed); raise modeChanged : mode
        }
        Running -> Running : packageDetected [valueof(packageDetected).weightGrams > settings.maxWeightGrams] / raise rejected : valueof(packageDetected)
        Running -> Careful : packageDetected [valueof(packageDetected).fragile && valueof(packageDetected).weightGrams <= settings.maxWeightGrams] / last = valueof(packageDetected); count++
        Careful -> Running : after 3 s
    }

    state Clearing {
        entry / mode = conveyor::Mode::Reverse; setSpeed(conveyor::kReverseSpeed); raise modeChanged : mode
    }

    state Faulted {
        entry / mode = conveyor::Mode::Stopped; setSpeed(0); raise modeChanged : mode
    }

    Idle -> Operating : start [count < conveyor::kMaintenanceInterval]
    Operating -> Idle : stop
    Operating -> Clearing : fault [valueof(fault) == conveyor::kJam] / faults = faults | valueof(fault)
    Operating -> Faulted : fault [valueof(fault) != conveyor::kJam] / faults = faults | valueof(fault)
    Clearing -> Operating : after 2 s / faults = faults & ~conveyor::kJam
    Faulted -> Idle : reset [(faults & conveyor::kEmergencyStop) == 0] / faults = conveyor::kNoFault
}
