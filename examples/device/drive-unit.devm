// The drive unit of the garage door (examples/device): a subsystem with its own threads.
import "types.devm"
import "components.devm"

/** Motor control, PWM output and end switches. */
subsystem DriveUnit {
    in async up : integer
    in async down : integer
    in async halt
    out async stopped
    out async blocked

    @priority(8) @period(1 ms) @stack(2048)
    thread MotorTask {
        motor : MotorController
        pwm : PwmDriver             // reads the duty cycle of the motor control
    }
    // the end switches and the current monitor are interrupt driven
    @priority(10) @stack(1024)
    thread SwitchTask {
        switches : EndSwitches
    }

    connect motor.duty -> pwm.duty
    connect switches.endSwitch -> motor.endSwitch
    connect switches.overcurrent -> motor.overcurrent
    delegate up -> motor.up
    delegate down -> motor.down
    delegate halt -> motor.halt
    delegate motor.stopped -> stopped
    delegate motor.blocked -> blocked
}
