// Motor control of the drive unit of the garage door (examples/device, component MotorController).
/** Runs the motor with the requested speed and reports why it stopped. */
statemachine Drive {
    @CycleBased(10)

    interface:
        /** Opens with the given speed in percent (port `up`). */
        in event up : integer
        /** Closes with the given speed in percent (port `down`). */
        in event down : integer
        in event halt
        /** An end switch was reached (port `endSwitch`). */
        in event endSwitch
        /** The motor current exceeded the limit (port `overcurrent`). */
        in event overcurrent
        out event stopped
        out event blocked
        /** The current speed in percent, negative while closing (port `speed`). */
        var speed : integer = 0
        /** The duty cycle of the PWM output in percent (port `duty`). */
        var duty : integer = 0

    [*] -> Idle

    state Idle {
        entry / speed = 0; duty = 0
    }
    state Running {
        entry / duty = speed
    }

    Idle -> Running : up / speed = valueof(up)
    Idle -> Running : down / speed = -valueof(down)
    Running -> Idle : halt
    Running -> Idle : endSwitch / raise stopped
    Running -> Idle : overcurrent / raise blocked
}
