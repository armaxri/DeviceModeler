// Component types of the garage door (examples/device). Ports carry data in a direction: sync ports
// data values, async ports one event (with an optional payload). Components with a `behavior` are
// implemented by a state machine; their ports must match its interfaces (see docs/structure-language.md).
import "types.devm"
import "door_types.h"

/** Opens and closes the door; implemented by controller.devm. */
component DoorController {
    behavior "controller.devm"
    in async open                   // commands of the remote control (events without data)
    in async close
    in async stop
    in async stopped                // the drive reached an end position
    in async blocked                // the drive detected an obstacle
    out async up : integer          // motor commands: speed in percent
    out async down : integer
    out async halt
    out async alarm
    in sync position : door::Position
    out sync cycles : integer
    inout sync errors : integer     // shared with the diagnosis
}

/** Motor control; implemented by drive.devm. */
component MotorController {
    behavior "drive.devm"
    in async up : integer
    in async down : integer
    in async halt
    in async endSwitch
    in async overcurrent
    out async stopped
    out async blocked
    out sync duty : integer         // duty cycle of the PWM output
    out sync speed : integer
}

/** PWM output of the motor bridge (hardware driver). */
component PwmDriver {
    in sync duty : integer
}

/** End switches and current monitor (hardware driver, interrupt driven). */
component EndSwitches {
    out async endSwitch
    out async overcurrent
}

/** Encoder of the door leaf. */
component PositionSensor {
    out sync position : door::Position
}

component Buzzer {
    in async alarm
}

/** Collects statistics. */
component Diagnosis {
    in sync cycles : integer
    inout sync errors : integer     // counted by the controller, reset after a report
    out sync report : Diagnostics
}

// The environment of the garage door, part of the closed system GarageInstallation (system.devm)

/** Hand-held remote control (radio receiver): sends the commands of its buttons. */
component RemoteControl {
    out async open
    out async close
    out async stop
}

/** Status display in the garage: shows the statistics of the door. */
component StatusDisplay {
    in sync report : Diagnostics
}
