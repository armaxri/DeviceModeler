// The courtesy light of the garage door (examples/device): a data type, components and a subsystem
// declared in one file. The diagram shows the subsystem and, next to it, the struct.
// The diagram is arranged by hand: the layout annotations (@at, @size, @port) keep the positions of the
// type box right of the frame, the instances and the port of the lamp driver (docs/manual-layout.md).

/** Brightness of the lamp. */
@at(720, 16)
struct LightLevel {
    brightness : integer
    warm : boolean
}

/** Fades the lamp in and out. */
component Dimmer {
    in async on
    in async off
    in async dim : integer
    out sync level : LightLevel
}

/** PWM output of the LED lamp. */
component LedDriver {
    in sync level : LightLevel
}

/** The courtesy light: switched on and off by the remote control. */
@at(112, 16)
subsystem CourtesyLight {
    in async on
    in async off
    in async dim : integer

    @priority(1) @period(20 ms) @at(41, 48) @size(500, 196)
    thread LightTask {
        @at(26, 52) dimmer : Dimmer
        @at(330, 96) @port(level, top, 40) led : LedDriver
    }

    connect dimmer.level -> led.level
    delegate on -> dimmer.on
    delegate off -> dimmer.off
    delegate dim -> dimmer.dim
}
