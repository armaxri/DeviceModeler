// The garage installation (examples/device): the closed, complete system – the garage door (a subsystem,
// garage-door.devm) together with its environment, the remote control and the status display. A system is
// the top level: it has no ports, everything it talks to is one of its parts (docs/structure-language.md).
import "components.devm"
import "garage-door.devm"

/** The garage with its door, the remote control and the status display. */
system GarageInstallation {
    @priority(4) @period(20 ms)
    thread RadioTask {
        remote : RemoteControl
    }
    @priority(1) @period(500 ms)
    thread DisplayTask {
        display : StatusDisplay
    }
    // a subsystem: outside of the threads, its parts run in the threads of GarageDoor
    door : GarageDoor

    connect remote.open -> door.open
    connect remote.close -> door.close
    connect remote.stop -> door.stop
    connect door.report -> display.report
}
