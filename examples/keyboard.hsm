// Orthogonal regions: caps lock and num lock are independent of each other.
statemachine Keyboard {
    interface:
        in event capsLock
        in event numLock
        in event suspend
        in event wakeUp
        in event unplug
        out event led : integer
        operation setLed(led : integer, on : boolean) : void

    internal:
        const CAPS : integer = 1
        const NUM : integer = 2

    [*] -> Active

    state Active {
        region CapsLock {
            [*] -> CapsOff
            state CapsOff
            state CapsOn {
                entry / setLed(CAPS, true); raise led : CAPS
                exit / setLed(CAPS, false)
            }
            CapsOff -> CapsOn : capsLock
            CapsOn -> CapsOff : capsLock
        }
        region NumLock {
            [*] -> NumOff
            state NumOff
            state NumOn {
                entry / setLed(NUM, true)
                exit / setLed(NUM, false)
            }
            NumOff -> NumOn : numLock
            NumOn -> NumOff : numLock
        }
    }

    state Suspended

    Active -> Suspended : suspend
    Suspended -> Active : wakeUp
    Active -> [*] : unplug
}
