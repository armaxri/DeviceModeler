<?xml version="1.0" encoding="UTF-8"?>
<feature
      id="hsm.eclipse.feature"
      label="HSM Modeler (prototype)"
      version="0.1.0.qualifier"
      provider-name="HSM Modeler">

   <description>
      Editor for hierarchical state machines (.hsm): the HSM web app (text editor and PlantUML-style
      diagram editor, simulation, export) in an embedded browser of the Eclipse IDE, and language support
      (diagnostics, completion, hover, navigation into C/C++ headers, formatting, outline, rename) for .hsm and
      .hsmtest files in Eclipse's Generic Editor through the HSM language server (LSP4E, TM4E).
   </description>

   <license url="https://opensource.org/licenses/MIT">
      See the LICENSE file of the HSM repository.
   </license>

   <plugin
         id="hsm.eclipse"
         version="0.0.0"/>

   <!-- language support in text editors (Generic Editor): language server via LSP4E, highlighting via TM4E;
        p2 installs LSP4E, TM4E and LSP4J from the Eclipse release repository (see README.md) -->
   <plugin
         id="hsm.eclipse.lsp"
         version="0.0.0"/>


   <!-- the hsm executable (validation of closed files) for linux x86_64 -->
   <plugin
         id="hsm.eclipse.cli.linux.x86_64"
         os="linux"
         arch="x86_64"
         version="0.0.0"
         fragment="true"/>

   <!-- the hsm executable (validation of closed files) for linux aarch64 -->
   <plugin
         id="hsm.eclipse.cli.linux.aarch64"
         os="linux"
         arch="aarch64"
         version="0.0.0"
         fragment="true"/>

   <!-- the hsm executable (validation of closed files) for macosx x86_64 -->
   <plugin
         id="hsm.eclipse.cli.macosx.x86_64"
         os="macosx"
         arch="x86_64"
         version="0.0.0"
         fragment="true"/>

   <!-- the hsm executable (validation of closed files) for macosx aarch64 -->
   <plugin
         id="hsm.eclipse.cli.macosx.aarch64"
         os="macosx"
         arch="aarch64"
         version="0.0.0"
         fragment="true"/>

   <!-- the hsm executable (validation of closed files) for win32 x86_64 -->
   <plugin
         id="hsm.eclipse.cli.win32.x86_64"
         os="win32"
         arch="x86_64"
         version="0.0.0"
         fragment="true"/>

</feature>
