<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <!-- .hsm files are text: other editors (Generic Editor, TM4E, LSP4E) can be bound to the content type -->
   <extension point="org.eclipse.core.contenttype.contentTypes">
      <content-type
            id="hsm.eclipse.hsm"
            name="HSM State Machine"
            base-type="org.eclipse.core.runtime.text"
            file-extensions="hsm"
            default-charset="UTF-8"
            priority="normal">
      </content-type>
   </extension>

   <!-- the web app (text editor + diagram) in an embedded browser -->
   <extension point="org.eclipse.ui.editors">
      <editor
            id="hsm.eclipse.editor"
            name="HSM Modeler"
            icon="icons/hsm.png"
            class="hsm.eclipse.HsmDiagramEditor"
            default="true">
         <contentTypeBinding contentTypeId="hsm.eclipse.hsm"/>
      </editor>
   </extension>

   <!-- problems of the models (Problems view); not persisted: the editor / builder report them again -->
   <extension id="problem" name="HSM Problem" point="org.eclipse.core.resources.markers">
      <super type="org.eclipse.core.resources.problemmarker"/>
      <super type="org.eclipse.core.resources.textmarker"/>
      <persistent value="false"/>
   </extension>

   <!-- validation of closed files on build (needs a ModelValidator, see hsm.eclipse.tools.HsmTools) -->
   <extension id="builder" name="HSM Validation" point="org.eclipse.core.resources.builders">
      <builder hasNature="true">
         <run class="hsm.eclipse.builder.HsmBuilder"/>
      </builder>
   </extension>
   <extension id="nature" name="HSM Models" point="org.eclipse.core.resources.natures">
      <runtime>
         <run class="hsm.eclipse.builder.HsmNature"/>
      </runtime>
      <builder id="hsm.eclipse.builder"/>
   </extension>

   <!-- preferences: C++ generation; the settings of the page are stored here, too -->
   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="hsm.eclipse.Preferences$Initializer"/>
   </extension>
   <extension point="org.eclipse.ui.preferencePages">
      <page id="hsm.eclipse.preferences" name="HSM Modeler" class="hsm.eclipse.HsmPreferencePage"/>
   </extension>

   <!-- commands -->
   <extension point="org.eclipse.ui.commands">
      <category id="hsm.eclipse.category" name="HSM Modeler"/>
      <command id="hsm.eclipse.generateCpp" categoryId="hsm.eclipse.category" name="Generate C++"
            description="Generates the C++ code of the state machine (hsm.gen.json or the HSM Modeler preferences)"/>
      <command id="hsm.eclipse.toggleNature" categoryId="hsm.eclipse.category" name="Enable / Disable HSM Validation"
            description="Adds or removes the HSM validation builder of the project"/>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler commandId="hsm.eclipse.generateCpp" class="hsm.eclipse.GenerateCppHandler"/>
      <handler commandId="hsm.eclipse.toggleNature" class="hsm.eclipse.builder.ToggleNatureHandler"/>
   </extension>
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command commandId="hsm.eclipse.generateCpp" label="Generate C++" icon="icons/hsm.png">
            <visibleWhen checkEnabled="false">
               <with variable="activeMenuSelection">
                  <iterate ifEmpty="false" operator="and">
                     <adapt type="org.eclipse.core.resources.IFile">
                        <test property="org.eclipse.core.resources.extension" value="hsm"/>
                     </adapt>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:org.eclipse.ui.projectConfigure?after=additions">
         <command commandId="hsm.eclipse.toggleNature" label="Enable / Disable HSM Validation">
            <visibleWhen checkEnabled="false">
               <with variable="activeMenuSelection">
                  <iterate ifEmpty="false" operator="and">
                     <adapt type="org.eclipse.core.resources.IProject"/>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
   </extension>
</plugin>
