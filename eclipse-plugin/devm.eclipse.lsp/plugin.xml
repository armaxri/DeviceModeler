<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <!-- unit tests of state machines (.devmtest); .devm is the content type devm.eclipse.devm of the plugin devm.eclipse -->
   <extension point="org.eclipse.core.contenttype.contentTypes">
      <content-type
            id="devm.eclipse.devmtest"
            name="Device Modeler Unit Test"
            base-type="org.eclipse.core.runtime.text"
            file-extensions="devmtest"
            default-charset="UTF-8"
            priority="normal">
      </content-type>
   </extension>

   <!-- the Generic Editor for both languages ("Open With > Generic Text Editor" for .devm, whose default editor stays
        the Device Modeler; the default editor of .devmtest); LSP4E and TM4E contribute their features to it -->
   <extension point="org.eclipse.ui.editors">
      <editorContentTypeBinding contentTypeId="devm.eclipse.devm" editorId="org.eclipse.ui.genericeditor.GenericEditor"/>
      <editorContentTypeBinding contentTypeId="devm.eclipse.devmtest" editorId="org.eclipse.ui.genericeditor.GenericEditor"/>
   </extension>

   <!-- the language server: "devm lsp" (stdio) of the devm executable (preference, platform fragment or PATH) -->
   <extension point="org.eclipse.lsp4e.languageServer">
      <server
            id="devm.eclipse.lsp.server"
            label="Device Modeler Language Server"
            class="devm.eclipse.lsp.DevmLanguageServer">
      </server>
      <contentTypeMapping contentType="devm.eclipse.devm" id="devm.eclipse.lsp.server" languageId="devm"/>
      <contentTypeMapping contentType="devm.eclipse.devmtest" id="devm.eclipse.lsp.server" languageId="devmtest"/>
   </extension>

   <!-- TextMate highlighting with the grammars of packages/language (the language server adds semantic tokens) -->
   <extension point="org.eclipse.tm4e.registry.grammars">
      <grammar scopeName="source.devm" path="syntaxes/devm.tmLanguage.json"/>
      <grammar scopeName="source.devmtest" path="syntaxes/devmtest.tmLanguage.json"/>
      <grammar scopeName="documentation.injection.devm" path="syntaxes/devm-doc-comments.tmLanguage.json"/>
      <injection scopeName="documentation.injection.devm" injectTo="source.devm"/>
      <injection scopeName="documentation.injection.devm" injectTo="source.devmtest"/>
      <scopeNameContentTypeBinding contentTypeId="devm.eclipse.devm" scopeName="source.devm"/>
      <scopeNameContentTypeBinding contentTypeId="devm.eclipse.devmtest" scopeName="source.devmtest"/>
   </extension>
   <extension point="org.eclipse.ui.genericeditor.presentationReconcilers">
      <presentationReconciler class="org.eclipse.tm4e.ui.text.TMPresentationReconciler" contentType="devm.eclipse.devm"/>
      <presentationReconciler class="org.eclipse.tm4e.ui.text.TMPresentationReconciler" contentType="devm.eclipse.devmtest"/>
   </extension>

   <!-- comments, brackets, auto closing, indentation (the language configuration of the VS Code extension) -->
   <extension point="org.eclipse.tm4e.languageconfiguration.languageConfigurations">
      <languageConfiguration contentTypeId="devm.eclipse.devm" path="language-configuration.json"/>
      <languageConfiguration contentTypeId="devm.eclipse.devmtest" path="language-configuration.json"/>
   </extension>
</plugin>
