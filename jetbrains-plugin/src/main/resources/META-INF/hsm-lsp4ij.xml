<!-- Language support in the text editor through Red Hat LSP4IJ (optional dependency, see plugin.xml): the language
     server `hsm lsp stdio` of the hsm executable for .hsm and .hsmtest files. Without LSP4IJ the plugin keeps its own
     lexer highlighting and the validation with the command line tool / the page. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="hsm" name="HSM Language Server" factoryClass="hsm.jetbrains.lsp.HsmLanguageServerFactory">
            <description><![CDATA[
            The language server of the HSM Modeler (<code>hsm lsp --stdio</code>): diagnostics, completion, hover,
            go to definition / declaration / type definition into C/C++ headers and other models, document links,
            formatting, outline, rename and semantic highlighting of <code>.hsm</code> and <code>.hsmtest</code> files.
            ]]></description>
        </server>
        <languageMapping language="HSM" serverId="hsm" languageId="hsm"/>
        <languageMapping language="HSMTest" serverId="hsm" languageId="hsmtest"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- tells the plugin that LSP4IJ runs the language server (HsmLanguageServerSupport) -->
        <applicationService serviceImplementation="hsm.jetbrains.lsp.Lsp4ijLoaded"/>
        <!-- LSP4IJ registers these for plain text / TextMate files only; the plugin's languages have their own PSI -->
        <lang.psiStructureViewFactory language="HSM"
                implementationClass="com.redhat.devtools.lsp4ij.features.documentSymbol.LSPDocumentSymbolStructureViewFactory"/>
        <lang.psiStructureViewFactory language="HSMTest"
                implementationClass="com.redhat.devtools.lsp4ij.features.documentSymbol.LSPDocumentSymbolStructureViewFactory"/>
        <lang.foldingBuilder language="HSM" implementationClass="com.redhat.devtools.lsp4ij.features.foldingRange.LSPFoldingRangeBuilder"/>
        <lang.foldingBuilder language="HSMTest" implementationClass="com.redhat.devtools.lsp4ij.features.foldingRange.LSPFoldingRangeBuilder"/>
        <codeBlockProvider language="HSM" implementationClass="com.redhat.devtools.lsp4ij.features.codeBlockProvider.LSPCodeBlockProvider"/>
        <codeBlockProvider language="HSMTest" implementationClass="com.redhat.devtools.lsp4ij.features.codeBlockProvider.LSPCodeBlockProvider"/>
        <!-- semantic tokens of the server (states, events, variables, C++ types, …) on top of the lexer highlighting -->
        <lang.fileViewProviderFactory language="HSM"
                implementationClass="com.redhat.devtools.lsp4ij.features.semanticTokens.viewProvider.LSPSemanticTokensFileViewProviderFactory"/>
        <lang.fileViewProviderFactory language="HSMTest"
                implementationClass="com.redhat.devtools.lsp4ij.features.semanticTokens.viewProvider.LSPSemanticTokensFileViewProviderFactory"/>
    </extensions>
</idea-plugin>
